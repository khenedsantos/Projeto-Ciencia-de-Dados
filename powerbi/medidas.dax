// Medidas de apoio: fórmulas verificadas estaticamente, não exportadas do PBIX.
// Registros publicados respeita o contexto atual; sem filtro inclui janeiro de 2023.
Registros publicados = COUNTROWS(ctps_emissoes)

// IG conta como categoria da fonte, não como uma 28ª unidade federativa.
Categorias UF com registros = DISTINCTCOUNT(ctps_emissoes[Sigla UF Órgão])

Primeira via = CALCULATE([Registros publicados], ctps_emissoes[Tipo Protocolo] = "1ª Via")

Segunda via = CALCULATE([Registros publicados], ctps_emissoes[Tipo Protocolo] = "2ª Via")

Percentual primeira via = DIVIDE([Primeira via], [Registros publicados])

// Alternativas explícitas para análises com recorte fixo, preservando os slicers.
Registros 2020-2022 =
CALCULATE(
    [Registros publicados],
    KEEPFILTERS(ctps_emissoes[data_ctps_gerada_date] >= DATE(2020, 1, 1)),
    KEEPFILTERS(ctps_emissoes[data_ctps_gerada_date] < DATE(2023, 1, 1))
)

Primeira via 2020-2022 =
CALCULATE([Registros 2020-2022], KEEPFILTERS(ctps_emissoes[Tipo Protocolo] = "1ª Via"))

Segunda via 2020-2022 =
CALCULATE([Registros 2020-2022], KEEPFILTERS(ctps_emissoes[Tipo Protocolo] = "2ª Via"))

Percentual primeira via 2020-2022 =
DIVIDE([Primeira via 2020-2022], [Registros 2020-2022])

// Base completa sem filtros: 25.844. Com filtros, recalcula no contexto selecionado.
// As 18 colunas de negócio são texto original com espaços das extremidades removidos.
// Não usar registro_id nem arquivo_fonte para este agrupamento.
Repeticoes de registros =
VAR Combinacoes = SUMMARIZE(
    ctps_emissoes,
    ctps_emissoes[Tipo Protocolo], ctps_emissoes[Data Protocolo],
    ctps_emissoes[Tipo CTPS], ctps_emissoes[Data CTPS Gerada],
    ctps_emissoes[Nome Órgão], ctps_emissoes[Nome Município Órgão],
    ctps_emissoes[Sigla UF Órgão], ctps_emissoes[Data Emissão],
    ctps_emissoes[Sexo], ctps_emissoes[Nível Escolaridade],
    ctps_emissoes[Raça e Cor], ctps_emissoes[Estado Civil],
    ctps_emissoes[Data Nascimento], ctps_emissoes[Tipo Cidadania],
    ctps_emissoes[Nome do País], ctps_emissoes[Descrição Nacionalidade],
    ctps_emissoes[Nome Município Nascimento], ctps_emissoes[Sigla UF Nascimento],
    "Linhas", COUNTROWS(ctps_emissoes)
)
RETURN COALESCE(SUMX(FILTER(Combinacoes, [Linhas] > 1), [Linhas] - 1), 0)
